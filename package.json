{
  "name": "mmd-encoder",
  "version": "1.6.1",
  "private": true,
  "description": "MMD 独立视频压制工具",
  "license": "MPL-2.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/tokens.mjs && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "format": "prettier --write src desktop backend locales scripts tests *.json README.md DESIGN.md UX-CONTRACT.md docs/CHANGELOG.md docs/THIRD-PARTY-NOTICES.md",
    "format:check": "prettier --check src desktop backend locales scripts tests *.json README.md DESIGN.md UX-CONTRACT.md docs/CHANGELOG.md docs/THIRD-PARTY-NOTICES.md",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "package:zip": "node scripts/zip-portable.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "prettier": "^3.5.0",
    "rcedit": "4.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "yaml": "^2.7.0"
  },
  "type": "module"
}
